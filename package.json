{
  "name": "album-deck",
  "version": "0.16.0",
  "description": "B 站长视频专辑的桌面播放控制器：时间戳点歌、切专辑、全局快捷键",
  "main": "src/main.js",
  "scripts": {
    "start": "node tools/launch.js",
    "pack:win": "node tools/pack-win.js",
    "test:api": "node tools/test-import.js",
    "test:cdp": "node tools/test-cdp.js",
    "test:geo": "node tools/test-geometry.js",
    "test:reorder": "node tools/test-reorder.js",
    "test:follow": "node tools/test-follow.js",
    "test:playing": "node tools/test-playing.js",
    "test:sort": "node tools/test-sort.js",
    "test:queue": "node --test tools/test-queue.js",
    "test:pause-cdp": "node tools/test-end-pause-cdp.js",
    "test:quality": "node --test tools/test-quality.js",
    "test:quality-live": "node tools/test-quality-bili.js",
    "test:performance": "node --test tools/test-performance.js",
    "bench:runtime": "node tools/bench.js",
    "test:all": "npm run test:geo && npm run test:playing && npm run test:follow && npm run test:sort && npm run test:reorder && npm run test:queue && npm run test:quality && npm run test:performance",
    "test:ui": "node tools/selftest.js --deck-minitest",
    "test:folder": "node tools/selftest.js --deck-fqtest",
    "test:mini-toggle": "node tools/selftest.js --deck-summontest",
    "repro": "node tools/selftest.js --deck-repro",
    "test:e2e": "node tools/e2e-runner.js"
  },
  "keywords": [
    "electron",
    "bilibili",
    "music",
    "player",
    "global-hotkey"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "electron": "^37.2.0"
  }
}
